# SIMULATION-ONLY change, guarded by `ifdef VERILATOR. Quartus takes the `else
# branch and sees the original tri-state assignments unchanged.
#
# sdram_dual.sv declares SDRAM_DQ as `inout reg` and drives it from nine
# separate procedural assignment sites. Verilator turns that into an
# out/enable pair and treats EACH site as its own latched driver, then
# OR-resolves them -- so every SDRAM write came back OR'd with every earlier
# one: 0x0000, then 0x0002, then a write of 0x0001 reached the bus as 0x0003.
# All SDRAM traffic was corrupted, which made the real BIOS fail its RAM test
# and never reach video setup.
#
# Confirmed by printing the controller's own SDRAM_DQ next to the bus value:
# the controller itself held 0x0003, so the bus resolution was innocent.
# Changing the idle value from Z to 0 does NOT fix it, because the
# accumulation is across assignment SITES rather than across the idle value.
# The fix routes all nine through DQ_IDLE / DQ_DRIVE onto one driver.
--- refs/Jaguar_MiSTer/rtl/mem/sdram_dual.sv	2026-10-02 14:51:02
--- refs/Jaguar_MiSTer/rtl/mem/sdram_dual.sv	2026-10-02 14:51:02
+++ rtl/upstream/mem/sdram_dual.sv	2026-10-02 22:37:36
@@ -41,7 +41,11 @@
 	input             init,        // reset to initialize RAM
 	input             clk,         // clock ~100MHz
 
+`ifdef VERILATOR
+	inout wire [15:0] SDRAM_DQ,    // 16 bit bidirectional data bus
+`else
 	inout  reg [15:0] SDRAM_DQ,    // 16 bit bidirectional data bus
+`endif
 	output reg [12:0] SDRAM_A,     // 13 bit multiplexed address bus
 	output            SDRAM_DQML,  // two byte masks
 	output            SDRAM_DQMH,  //
@@ -89,6 +93,30 @@
 	input             self_refresh // 1 - self control, 0 - refresh on ch1_ref
 );
 
+// SIMULATION ONLY. Quartus takes the `else branch and sees the original
+// tri-state assignments unchanged.
+//
+// The simulator turns an `inout reg` into an out/enable pair and treats each
+// procedural assignment site as its own latched driver, OR-resolving them all.
+// With nine assignment sites in this module, every SDRAM write came back OR'd
+// with every earlier one (0x0000, then 0x0002, then a write of 0x0001 reached
+// the bus as 0x0003). That corrupted all SDRAM traffic, so the real BIOS failed
+// its RAM test and never reached video setup. Idling at 0 does not help: the
+// accumulation is across assignment SITES. The fix is to drive the bus from
+// exactly one place.
+`ifdef VERILATOR
+reg [15:0] dq_out_r = 16'h0;
+reg        dq_oe_r  = 1'b0;
+// Idle at 0, not Z: sim/sdram_model.sv also idles at 0, so with OR-resolution
+// exactly one side contributes at a time.
+assign SDRAM_DQ = dq_oe_r ? dq_out_r : 16'h0000;
+`define DQ_IDLE      dq_oe_r <= 1'b0
+`define DQ_DRIVE(v)  begin dq_out_r <= (v); dq_oe_r <= 1'b1; end
+`else
+`define DQ_IDLE      SDRAM_DQ <= 16'bZ
+`define DQ_DRIVE(v)  SDRAM_DQ <= (v)
+`endif
+
 assign SDRAM_nCS  = 0;
 assign SDRAM_nRAS = command[2];
 assign SDRAM_nCAS = command[1];
